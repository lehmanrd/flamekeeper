#!/usr/bin/env bash
# flamekeeper: manage the FlameKeeper controller installed by install.sh.
set -euo pipefail

FK_REPO="__FK_REPO__"
FK_INSTALL_DIR="${FK_INSTALL_DIR:-__FK_INSTALL_DIR__}"
[[ "$FK_INSTALL_DIR" == __*__ ]] && FK_INSTALL_DIR=/opt/flamekeeper
ENV_FILE="$FK_INSTALL_DIR/.env"
# Updates requested from the web UI: the request comes in through DATA_DIR/self-update,
# the log and result go out through here (root's; read-only in the controller).
UPDATE_DIR="$FK_INSTALL_DIR/self-update"
SYSTEMD_DIR="${FK_SYSTEMD_DIR:-/etc/systemd/system}"
# What the importer may touch, read by the docker proxy only (docs/socket-proxy.md).
GRANT_FILE="$FK_INSTALL_DIR/proxy/import.json"
GRANT_SECONDS=3600

die() {
  printf 'flamekeeper: %s\n' "$*" >&2
  exit 1
}

usage() {
  cat <<EOF
Usage: flamekeeper <command>

  status              Controller and game server status
  logs [-f]           Controller logs (-f to follow)
  start | stop | restart
                      Start/stop/restart the controller. Game servers keep running.
  update [--version v] [--no-firewall]
                      Upgrade FlameKeeper (re-runs the installer, keeps settings)
  doctor              Check Docker, ports, disk and the controller's self-check
  import --allow PATH|CONTAINER...
                      Let FlameKeeper import from this folder or container for an hour
                      (replaces what was allowed before)
  import [--done]     Show what FlameKeeper may import from, or withdraw it
  reset-admin         Set the admin username and password (first setup, or a forgotten
                      password). Signs everyone out.
  uninstall [--purge] Remove the controller. --purge also deletes all game servers,
                      saves and backups.
  update-request      (Run by systemd) Carry out an update requested in the web UI
  version             Show the installed version
EOF
}

env_get() {
  [[ -f "$ENV_FILE" ]] || return 0
  sed -n "s/^$1=//p" "$ENV_FILE" | tail -n1
}

need_install() {
  [[ -f "$FK_INSTALL_DIR/docker-compose.yml" ]] || die "not installed in $FK_INSTALL_DIR"
}

dk() {
  if docker info >/dev/null 2>&1; then
    docker "$@"
  elif [[ "$(id -u)" -ne 0 ]] && command -v sudo >/dev/null 2>&1; then
    sudo docker "$@"
  else
    die "can't reach Docker (is it running? are you root or in the docker group?)"
  fi
}

compose() {
  need_install
  (cd "$FK_INSTALL_DIR" && dk compose "$@")
}

ui_url() {
  local bind port base
  bind="$(env_get FLAMEKEEPER_BIND)"
  port="$(env_get FLAMEKEEPER_PORT)"
  base="$(env_get BASE_PATH)"
  [[ -z "$bind" || "$bind" == "0.0.0.0" ]] && bind=127.0.0.1
  echo "http://${bind}:${port:-8080}${base%/}"
}

cmd_status() {
  need_install
  echo "Controller:"
  compose ps --format '{{.Name}}  {{.State}}  {{.Status}}  {{.Image}}' 2>/dev/null | sed 's/^/  /' ||
    compose ps
  local health
  if health="$(curl -fsS --max-time 3 "$(ui_url)/api/health" 2>/dev/null)"; then
    echo "  API: ok ($(ui_url))"
    case "$health" in
      *'"setup_error":null'*) ;;
      *) echo "  Setup problem: $(printf '%s' "$health" | sed -n 's/.*"setup_error":"\([^"]*\)".*/\1/p')" ;;
    esac
  else
    echo "  API: not answering at $(ui_url)"
  fi
  echo
  echo "Game servers:"
  dk ps -a --filter label=flamekeeper.managed=true \
    --format '  {{.Names}}  {{.Status}}  {{.Ports}}' | grep -v '^  $' || echo "  (none)"
}

cmd_update() {
  local args=(--yes) url version=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --version) version="${2:?}"; shift ;;
      --no-firewall) args+=(--no-firewall) ;;
      *) die "unknown option $1" ;;
    esac
    shift
  done
  [[ "$FK_REPO" == __*__ ]] && die "this is a development install; re-run installer/install.sh from your checkout"
  url="https://github.com/${FK_REPO}/releases/latest/download/install.sh"
  if [[ -n "$version" ]]; then
    version="${version#v}"
    args+=(--version "$version")
    url="https://github.com/${FK_REPO}/releases/download/v${version}/install.sh"
  fi
  echo "Downloading $url"
  local tmp
  tmp="$(mktemp)"
  curl -fsSL "$url" -o "$tmp" || die "download failed"
  # The installer's status, explicitly: set -e doesn't apply when the caller tests
  # this function (update-request runs it as `(cmd_update …) || rc=$?`).
  local rc=0
  FK_INSTALL_DIR="$FK_INSTALL_DIR" bash "$tmp" "${args[@]}" || rc=$?
  rm -f "$tmp"
  return "$rc"
}

# real_dir DIR: DIR with every symlink resolved (portable: busybox realpath has no -e).
real_dir() {
  (cd "$1" 2>/dev/null && pwd -P)
}

# newer A B: version A is newer than version B
newer() {
  [[ "$1" != "$2" && "$(printf '%s\n%s\n' "$1" "$2" | sort -V | tail -n1)" == "$1" ]]
}

# write_status ID VERSION STATE [EXIT_CODE] [ERROR]: the result the controller reads.
write_status() {
  local tmp
  tmp="$(mktemp "$UPDATE_DIR/.status.XXXXXX")"
  printf '{"id": "%s", "version": "%s", "state": "%s", "exit_code": %s, "error": "%s", "at": "%s"}\n' \
    "$1" "$2" "$3" "${4:-null}" "${5:-}" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >"$tmp"
  chmod 0644 "$tmp"
  mv -f "$tmp" "$UPDATE_DIR/status.json"
}

# An update requested in the web UI (flamekeeper-update.service, started by
# flamekeeper-update.path when DATA_DIR/self-update/request appears). FlameKeeper can write
# anything in DATA_DIR, so the request is read as untrusted input: a regular file, a
# release version newer than the installed one, and nothing else. See docs/socket-proxy.md.
cmd_update_request() {
  [[ "$(id -u)" -eq 0 ]] || die "update-request runs as root (from systemd)"
  local data_dir dir req line version id extra current rc
  data_dir="$(env_get DATA_DIR)"
  [[ "$data_dir" == /* ]] || die "DATA_DIR isn't set in $ENV_FILE"
  dir="$data_dir/self-update"
  req="$dir/request"
  # A symlinked folder could point the rm below somewhere else.
  [[ "$(real_dir "$dir")" == "$dir" ]] || die "$dir isn't a plain folder"
  if [[ ! -f "$req" || -L "$req" ]]; then
    rm -f -- "$req"
    die "no update request in $dir"
  fi
  line="$(timeout 5 head -c 100 -- "$req" 2>/dev/null | head -n1 || true)"
  rm -f -- "$req"
  read -r version id extra <<<"$line" || true
  [[ "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ && "$id" =~ ^[0-9a-f]{16}$ && -z "${extra:-}" ]] ||
    die "ignoring a malformed update request"

  mkdir -p "$UPDATE_DIR"
  chmod 0755 "$UPDATE_DIR"
  current="$(env_get FLAMEKEEPER_IMAGE)"
  current="${current##*:}"
  # Development images (flamekeeper:dev) have no version to compare with.
  if [[ "$current" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] && ! newer "$version" "$current"; then
    write_status "$id" "$version" failed null "$version isn't newer than the installed $current"
    die "refusing to update to $version: not newer than $current"
  fi

  write_status "$id" "$version" running
  : >"$UPDATE_DIR/update.log"
  chmod 0644 "$UPDATE_DIR/update.log"
  rc=0
  (cmd_update --version "$version" --no-firewall) >>"$UPDATE_DIR/update.log" 2>&1 || rc=$?
  if [[ "$rc" -eq 0 ]]; then
    write_status "$id" "$version" succeeded 0
  else
    write_status "$id" "$version" failed "$rc"
  fi
  return "$rc"
}

# json_list A B C → "A", "B", "C" (callers reject quotes, backslashes and control characters)
json_list() {
  local out="" item
  for item in "$@"; do out+="${out:+, }\"$item\""; done
  printf '%s' "$out"
}

grant_status() {
  local until now
  if [[ ! -f "$GRANT_FILE" ]]; then
    echo "FlameKeeper may not import from anything (sudo flamekeeper import --allow PATH|CONTAINER)."
    return 0
  fi
  until="$(sed -n 's/.*"until": *\([0-9]*\).*/\1/p' "$GRANT_FILE")"
  now="$(date +%s)"
  if [[ -z "$until" || "$until" -le "$now" ]]; then
    echo "FlameKeeper may not import from anything (the last permission expired)."
    return 0
  fi
  echo "FlameKeeper may import from these until $(date -d "@$until" '+%H:%M'):"
  sed -n 's/.*"paths": *\[\(.*\)\], *"containers".*/\1/p' "$GRANT_FILE" | tr ',' '\n' |
    sed -n 's/^ *"\(.*\)"$/  folder     \1/p'
  sed -n 's/.*"containers": *\[\(.*\)\].*/\1/p' "$GRANT_FILE" | tr ',' '\n' |
    sed -n 's/^ *"\(.*\)"$/  container  \1/p'
}

# The importer reads the old server's files and stops, starts and removes its container:
# things outside FlameKeeper's own folder, which the docker proxy only allows for what the
# admin names here. FlameKeeper can't write this file.
cmd_import() {
  need_install
  case "${1:-}" in
    "" | --status) grant_status; return ;;
    --done)
      [[ "$(id -u)" -eq 0 ]] || die "run as root (sudo flamekeeper import --done)"
      rm -f "$GRANT_FILE"
      echo "FlameKeeper may no longer import from anything."
      return ;;
    --allow) shift ;;
    *) die "usage: flamekeeper import --allow PATH|CONTAINER... | --done" ;;
  esac
  [[ $# -gt 0 ]] || die "usage: flamekeeper import --allow PATH|CONTAINER..."
  [[ "$(id -u)" -eq 0 ]] || die "run as root (sudo flamekeeper import --allow ...)"
  local paths=() containers=() arg real until tmp
  for arg in "$@"; do
    if [[ "$arg" == /* ]]; then
      [[ -d "$arg" ]] || die "$arg isn't a folder"
      real="$(real_dir "$arg")" || die "$arg doesn't exist"
      [[ "$real" != "/" ]] || die "choose the old server's folder, not /"
      if [[ "$real" =~ [[:cntrl:]] || "$real" == *'"'* || "$real" == *"\\"* ]]; then
        die "can't allow $arg: its path has quotes, backslashes or control characters"
      fi
      # The proxy compares the folder FlameKeeper mounts with this exactly.
      [[ "$real" == "$arg" ]] || echo "Note: $arg is really $real; enter $real in FlameKeeper."
      paths+=("$real")
    else
      [[ "$arg" =~ ^[A-Za-z0-9][A-Za-z0-9_.-]*$ ]] || die "$arg isn't a folder (start with /) or a container name"
      dk inspect --type container "$arg" >/dev/null 2>&1 || die "there's no container named $arg"
      if [[ "$(dk inspect --type container --format '{{index .Config.Labels "flamekeeper.managed"}}' "$arg")" == true ]]; then
        die "$arg is already one of FlameKeeper's containers"
      fi
      containers+=("$arg")
    fi
  done
  until=$(($(date +%s) + GRANT_SECONDS))
  mkdir -p "$(dirname "$GRANT_FILE")"
  tmp="$(mktemp "$(dirname "$GRANT_FILE")/.import.XXXXXX")"
  printf '{"until": %s, "paths": [%s], "containers": [%s]}\n' "$until" \
    "$(json_list "${paths[@]}")" "$(json_list "${containers[@]}")" >"$tmp"
  chmod 0644 "$tmp"
  mv -f "$tmp" "$GRANT_FILE"
  grant_status
  echo "Go back to FlameKeeper and try again. Withdraw early: sudo flamekeeper import --done"
}

remove_updater() {
  if command -v systemctl >/dev/null 2>&1 && [[ -f "$SYSTEMD_DIR/flamekeeper-update.path" ]]; then
    systemctl disable --now flamekeeper-update.path >/dev/null 2>&1 || true
  fi
  rm -f "$SYSTEMD_DIR/flamekeeper-update.path" "$SYSTEMD_DIR/flamekeeper-update.service"
  command -v systemctl >/dev/null 2>&1 && systemctl daemon-reload >/dev/null 2>&1 || true
}

cmd_doctor() {
  local rc=0 data_dir free_gb
  echo "Docker:"
  if dk version --format '  engine {{.Server.Version}}, API {{.Server.APIVersion}}' 2>/dev/null; then :; else
    echo "  NOT REACHABLE"; rc=1
  fi
  dk compose version 2>/dev/null | sed 's/^/  /' || { echo "  compose plugin missing"; rc=1; }
  data_dir="$(env_get DATA_DIR)"
  if [[ -n "$data_dir" && -d "$data_dir" ]]; then
    free_gb="$(df -Pk "$data_dir" | awk 'NR==2 {print int($4/1024/1024)}')"
    echo "Disk: ${free_gb} GB free in $data_dir"
  fi
  echo "Self-check:"
  # Runs inside the controller container: the API needs a signed-in admin.
  if ! dk exec flamekeeper python -m app.cli selfcheck; then
    rc=1
  fi
  return "$rc"
}

cmd_uninstall() {
  local purge=0 data_dir answer
  [[ "${1:-}" == "--purge" ]] && purge=1
  [[ "$(id -u)" -eq 0 ]] || die "run as root (sudo flamekeeper uninstall)"
  data_dir="$(env_get DATA_DIR)"
  if [[ "$purge" == 1 ]]; then
    echo "This deletes EVERYTHING FlameKeeper manages:"
    dk ps -a --filter label=flamekeeper.managed=true --format '  container {{.Names}}'
    [[ -n "$data_dir" ]] && echo "  data      $data_dir (worlds, saves, backups)"
    printf 'Type "flamekeeper" to confirm: '
    read -r answer </dev/tty
    [[ "$answer" == "flamekeeper" ]] || die "aborted"
  fi
  [[ -f "$FK_INSTALL_DIR/docker-compose.yml" ]] && compose down --volumes || true
  remove_updater
  if [[ "$purge" == 1 ]]; then
    local ids=()
    mapfile -t ids < <(dk ps -aq --filter label=flamekeeper.managed=true)
    [[ ${#ids[@]} -gt 0 ]] && dk rm -f "${ids[@]}" >/dev/null
    dk network rm flamekeeper >/dev/null 2>&1 || true
    [[ -n "$data_dir" && "$data_dir" != "/" ]] && rm -rf "$data_dir"
  fi
  rm -rf "$FK_INSTALL_DIR"
  rm -f "$0"
  echo "FlameKeeper removed."
  if [[ "$purge" == 0 ]]; then
    echo "Game servers keep running and your data is still in ${data_dir:-the data folder}."
    echo "Re-run the installer to manage them again, or remove them with:"
    echo "  docker rm -f \$(docker ps -aq --filter label=flamekeeper.managed=true)"
  fi
}

cmd_reset_admin() {
  need_install
  { : </dev/tty; } 2>/dev/null || die "reset-admin needs a terminal"
  local user password confirm
  echo "Set the FlameKeeper admin account. This replaces any existing one and signs"
  echo "everyone out; game servers keep running."
  read -r -p "Username [admin]: " user </dev/tty || user=""
  user="${user:-admin}"
  read -rs -p "New password (at least 8 characters): " password </dev/tty || password=""
  echo
  read -rs -p "New password again: " confirm </dev/tty || confirm=""
  echo
  [[ "$password" == "$confirm" ]] || die "the passwords don't match"
  printf '%s\n' "$password" | dk exec -i flamekeeper python -m app.cli set-admin "$user"
}

main() {
  local cmd="${1:-}"
  [[ $# -gt 0 ]] && shift
  case "$cmd" in
    status) cmd_status ;;
    logs) compose logs --tail 200 "$@" ;;
    start) compose up -d ;;
    stop) compose stop ;;
    restart) compose up -d --force-recreate ;;
    update) cmd_update "$@" ;;
    update-request) cmd_update_request ;;
    import) cmd_import "$@" ;;
    doctor) cmd_doctor ;;
    reset-admin) cmd_reset_admin ;;
    uninstall) cmd_uninstall "$@" ;;
    version) env_get FLAMEKEEPER_IMAGE | sed 's/.*://' ;;
    "" | -h | --help | help) usage ;;
    *) usage >&2; exit 2 ;;
  esac
}

main "$@"
